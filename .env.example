# Copie este arquivo para .env e ajuste se precisar.

# Endereço do MySQL: mysql://usuario:senha@servidor:porta/nome_do_banco
# O padrão (sem .env) é o MySQL local com usuário root sem senha.
DATABASE_URL=mysql://root@127.0.0.1:3306/ecocondo

# Para MySQL na nuvem que exige conexão segura:
# DATABASE_SSL=true
# DATABASE_SSL_CA=./ca.pem   (ou o texto do certificado, de -----BEGIN até -----END)

# JWT_SECRET=troque-por-uma-frase-longa-e-aleatoria
# LOGIN_DEMONSTRACAO=desativado
